<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cinema.mapper.SetmealGoodMapper">

    <insert id="insertBatch">
        insert into setmeal_good (setmeal_id, good_id, name, price, copies) VALUES
        <foreach collection="setmealGoods" item="setmealGood" separator=",">
             (#{setmealGood.setmealId},#{setmealGood.goodId},#{setmealGood.name},#{setmealGood.price},#{setmealGood.copies})
        </foreach>
    </insert>
    <select id="getBySetmealId" resultType="com.cinema.entity.SetmealGood">
        select * from setmeal_good where setmeal_id =#{setmealId}
    </select>
</mapper>