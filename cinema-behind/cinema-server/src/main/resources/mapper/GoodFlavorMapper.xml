<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cinema.mapper.GoodFlavorMapper">

    <insert id="saveFlavors">
        insert into good_flavor (good_id, name, value) VALUES
        <foreach collection="goodFlavors" item="goodflavor"  separator=",">
         (#{goodflavor.goodId},#{goodflavor.name},#{goodflavor.value})
        </foreach>
    </insert>
</mapper>
