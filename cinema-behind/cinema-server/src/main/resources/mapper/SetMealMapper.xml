<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cinema.mapper.SetMealMapper">

    <select id="getSetMealIdsByGoodIds" resultType="com.cinema.entity.SetMeal">
        select setmeal_id from setmeal_good where id in
        <foreach collection="goodIds" item="goodId" close=")" open="(" separator=",">
            #{goodId}
        </foreach>
    </select>
</mapper>
